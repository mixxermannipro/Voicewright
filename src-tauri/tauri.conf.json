{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VoxTakt",
  "version": "0.1.0-alpha.1",
  "identifier": "de.voxtakt.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "VoxTakt",
        "width": 940,
        "height": 760,
        "minWidth": 450,
        "minHeight": 530
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; style-src 'self'; img-src 'self' data:; object-src 'none'; frame-src 'none'; base-uri 'none'; form-action 'none'",
      "devCsp": "default-src 'self'; connect-src ipc: http://ipc.localhost ws://127.0.0.1:1420; style-src 'self' 'unsafe-inline'; img-src 'self' data:; object-src 'none'; frame-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/voxtakt-cleanup"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "Local desktop dictation",
    "longDescription": "Offline speech recognition and optional text cleanup on your desktop.",
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "license": "MIT",
    "licenseFile": "../LICENSE",
    "resources": [
      "../LICENSE",
      "../docs/THIRD_PARTY_LICENSES.md"
    ],
    "linux": {
      "deb": {
        "depends": [
          "libasound2t64 | libasound2",
          "libstdc++6",
          "libgcc-s1"
        ]
      }
    }
  }
}
